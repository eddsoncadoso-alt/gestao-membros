const { createClient } = supabase;

const appState = {
  session: null,
  perfil: null,
  igreja: null,
  filiais: [],
  membros: [],
  perfis: [],
};

const menuItems = {
  admin: [
    { id: 'inicio', label: '🏠 Início' },
    { id: 'igrejas', label: '🏢 Igrejas' },
    { id: 'filiais', label: '📍 Filiais' },
    { id: 'membros', label: '👥 Membros' },
    { id: 'acessos', label: '🔑 Acessos' },
    { id: 'perfil', label: '⚙️ Perfil' },
  ],
  master: [
    { id: 'inicio', label: '🏠 Início' },
    { id: 'filiais', label: '📍 Filiais' },
    { id: 'membros', label: '👥 Membros' },
    { id: 'acessos', label: '🔑 Acessos' },
    { id: 'perfil', label: '⚙️ Perfil' },
  ],
  filial: [
    { id: 'inicio', label: '🏠 Início' },
    { id: 'membros', label: '👥 Membros' },
    { id: 'acessos', label: '🔑 Acessos' },
    { id: 'perfil', label: '⚙️ Perfil' },
  ],
  membro: [
    { id: 'inicio', label: '🏠 Início' },
    { id: 'perfil', label: '⚙️ Perfil' },
  ],
};

const supabase = createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY);

function getCurrentPerfil() {
  return appState.perfil;
}

function showError(node, message) {
  if (!node) return;
  node.textContent = message || '';
}

function setLoadingText(node, text) {
  if (node) node.textContent = text;
}

function renderMenu() {
  const perfil = getCurrentPerfil();
  const items = perfil ? menuItems[perfil.papel] || menuItems.membro : [];
  const menu = document.getElementById('menu');
  menu.innerHTML = items
    .map((item) => `<button class="nav-item" data-page="${item.id}">${item.label}</button>`)
    .join('');

  menu.querySelectorAll('.nav-item').forEach((button) => {
    button.addEventListener('click', () => {
      const page = button.dataset.page;
      renderPage(page);
      menu.querySelectorAll('.nav-item').forEach((btn) => btn.classList.toggle('active', btn === button));
    });
  });
}

async function loadPerfil() {
  const { data: sessionData } = await supabase.auth.getSession();
  appState.session = sessionData.session;

  if (!appState.session) {
    toggleLogin(true);
    return;
  }

  const { data: perfilData, error } = await supabase
    .from('perfis')
    .select('*')
    .eq('id', appState.session.user.id)
    .maybeSingle();

  if (error || !perfilData) {
    showError(document.getElementById('loginError'), 'Seu perfil ainda não foi configurado.');
    toggleLogin(true);
    return;
  }

  appState.perfil = perfilData;
  document.getElementById('userName').textContent = perfilData.nome || appState.session.user.email;
  const initials = (perfilData.nome || appState.session.user.email || 'U').slice(0, 1).toUpperCase();
  document.getElementById('userAvatar').textContent = initials;

  toggleLogin(false);
  renderMenu();
  renderPage('inicio');
}

function toggleLogin(show) {
  document.getElementById('loginScreen').classList.toggle('active', show);
  document.getElementById('app').style.display = show ? 'none' : 'flex';
}

async function handleLogin() {
  const email = document.getElementById('email').value.trim();
  const password = document.getElementById('password').value;
  const errorNode = document.getElementById('loginError');

  if (!email || !password) {
    showError(errorNode, 'Informe e-mail e senha.');
    return;
  }

  const { data, error } = await supabase.auth.signInWithPassword({ email, password });
  if (error) {
    showError(errorNode, error.message || 'Erro ao entrar.');
    return;
  }

  appState.session = data.session;
  await loadPerfil();
}

async function handleForgotPassword() {
  const email = document.getElementById('email').value.trim();
  if (!email) {
    showError(document.getElementById('loginError'), 'Digite seu e-mail antes de recuperar a senha.');
    return;
  }
  const { error } = await supabase.auth.resetPasswordForEmail(email, {
    redirectTo: window.location.origin,
  });
  if (error) {
    showError(document.getElementById('loginError'), error.message || 'Não foi possível enviar o link.');
  } else {
    showError(document.getElementById('loginError'), 'Se este e-mail estiver cadastrado, enviamos instruções.');
  }
}

function pageCard(value, label) {
  return `
    <div class="card">
      <span class="value">${value}</span>
      <span class="label">${label}</span>
    </div>
  `;
}

async function fetchVisibleFiliais() {
  const perfil = getCurrentPerfil();
  if (!perfil) return [];

  let query = supabase.from('filiais').select('*');
  if (perfil.papel === 'master') {
    query = query.eq('igreja_id', perfil.igreja_id);
  }
  if (perfil.papel === 'filial') {
    query = query.eq('id', perfil.filial_id);
  }
  if (perfil.papel === 'membro') {
    return [];
  }

  const { data, error } = await query.order('nome');
  if (error) throw error;
  return data || [];
}

async function fetchVisibleMembros() {
  const perfil = getCurrentPerfil();
  if (!perfil) return [];

  if (perfil.papel === 'membro') {
    const { data, error } = await supabase.from('membros').select('*').eq('id', perfil.membro_id || '00000000-0000-0000-0000-000000000000');
    if (error) throw error;
    return data || [];
  }

  let query = supabase.from('membros').select('*');
  if (perfil.papel === 'master') {
    query = query.eq('igreja_id', perfil.igreja_id);
  }
  if (perfil.papel === 'filial') {
    query = query.eq('filial_id', perfil.filial_id);
  }

  const { data, error } = await query.order('nome');
  if (error) throw error;
  return data || [];
}

async function fetchVisiblePerfis() {
  const perfil = getCurrentPerfil();
  if (!perfil) return [];

  let query = supabase.from('perfis').select('*');
  if (perfil.papel === 'master') {
    query = query.eq('igreja_id', perfil.igreja_id);
  }
  if (perfil.papel === 'filial') {
    query = query.eq('filial_id', perfil.filial_id);
  }
  if (perfil.papel === 'membro') {
    query = query.eq('id', perfil.id);
  }

  const { data, error } = await query.order('nome');
  if (error) throw error;
  return data || [];
}

async function renderPage(page) {
  const perfil = getCurrentPerfil();
  const pageNode = document.getElementById('page');

  if (!perfil) {
    pageNode.innerHTML = '<p>Faça login para continuar.</p>';
    return;
  }

  if (page === 'inicio') {
    const [filiais, membros, perfis] = await Promise.all([
      fetchVisibleFiliais(),
      fetchVisibleMembros(),
      fetchVisiblePerfis(),
    ]);

    pageNode.innerHTML = `
      <div class="page-title">
        <h1>Início</h1>
      </div>
      <div class="card-grid">
        ${pageCard(filiais.length, 'Filiais')}
        ${pageCard(membros.length, 'Membros')}
        ${pageCard(perfis.length, 'Acessos')}
      </div>
      <div class="section">
        <h3>Resumo</h3>
        <p>Bem-vindo ao sistema de gestão de membros. Aqui você acompanha igrejas, filiais, membros e acessos.</p>
      </div>
    `;
    return;
  }

  if (page === 'filiais') {
    const filiais = await fetchVisibleFiliais();
    const rows = filiais.map((filial) => `
      <tr>
        <td>${filial.nome}</td>
        <td>${filial.responsavel || '-'}</td>
        <td>${filial.contato || '-'}</td>
        <td>${filial.is_sede ? '<span class="badge">Sede</span>' : 'Filial'}</td>
      </tr>
    `).join('');

    pageNode.innerHTML = `
      <div class="page-title">
        <h1>Filiais</h1>
      </div>
      <div class="section">
        <table class="table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Responsável</th>
              <th>Contato</th>
              <th>Tipo</th>
            </tr>
          </thead>
          <tbody>${rows || '<tr><td colspan="4">Nenhuma filial cadastrada.</td></tr>'}</tbody>
        </table>
      </div>
    `;
    return;
  }

  if (page === 'membros') {
    const membros = await fetchVisibleMembros();
    const rows = membros.map((membro) => `
      <tr>
        <td>${membro.nome}</td>
        <td>${membro.telefone || '-'}</td>
        <td>${membro.email || '-'}</td>
        <td>${membro.situacao || 'ativo'}</td>
      </tr>
    `).join('');

    pageNode.innerHTML = `
      <div class="page-title">
        <h1>Membros</h1>
      </div>
      <div class="section">
        <table class="table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Telefone</th>
              <th>E-mail</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>${rows || '<tr><td colspan="4">Nenhum membro cadastrado.</td></tr>'}</tbody>
        </table>
      </div>
    `;
    return;
  }

  if (page === 'acessos') {
    const perfis = await fetchVisiblePerfis();
    const rows = perfis.map((perfil) => `
      <tr>
        <td>${perfil.nome}</td>
        <td>${perfil.email}</td>
        <td>${perfil.papel}</td>
        <td>${perfil.ativo ? '<span class="badge">Ativo</span>' : 'Desativado'}</td>
      </tr>
    `).join('');

    pageNode.innerHTML = `
      <div class="page-title">
        <h1>Acessos</h1>
      </div>
      <div class="section">
        <table class="table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Perfil</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>${rows || '<tr><td colspan="4">Nenhum acesso cadastrado.</td></tr>'}</tbody>
        </table>
      </div>
    `;
    return;
  }

  if (page === 'perfil') {
    pageNode.innerHTML = `
      <div class="page-title">
        <h1>Perfil</h1>
      </div>
      <div class="section">
        <p><strong>Nome:</strong> ${perfil.nome}</p>
        <p><strong>E-mail:</strong> ${perfil.email}</p>
        <p><strong>Papel:</strong> ${perfil.papel}</p>
        <p><strong>Ativo:</strong> ${perfil.ativo ? 'Sim' : 'Não'}</p>
        <button id="logoutBtn" class="danger">Sair</button>
      </div>
    `;

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await supabase.auth.signOut();
      appState.session = null;
      appState.perfil = null;
      document.getElementById('email').value = '';
      document.getElementById('password').value = '';
      document.getElementById('loginError').textContent = '';
      toggleLogin(true);
    });
    return;
  }
}

async function initCadastroPublico() {
  const params = new URLSearchParams(window.location.search);
  const token = params.get('convite');
  const cadastroBox = document.getElementById('cadastroBox');
  const loginBox = document.getElementById('loginBox');
  const cadastroForm = document.getElementById('cadastroForm');
  const cadastroMensagem = document.getElementById('cadastroMensagem');

  if (!token) {
    loginBox.classList.remove('hidden');
    cadastroBox.classList.add('hidden');
    return;
  }

  loginBox.classList.add('hidden');
  cadastroBox.classList.remove('hidden');
  cadastroMensagem.textContent = 'Validando convite...';

  try {
    const response = await fetch(`${window.SUPABASE_URL}/functions/v1/cadastro-membro`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': window.SUPABASE_ANON_KEY,
      },
      body: JSON.stringify({ acao: 'info', token }),
    });

    const result = await response.json();

    if (!response.ok || result.erro) {
      cadastroMensagem.textContent = result.erro || 'Convite inválido.';
      return;
    }

    document.getElementById('cadastroIgreja').textContent = result.igreja;
    document.getElementById('cadastroFilial').textContent = result.is_sede ? 'Sede' : `Filial ${result.filial}`;
    cadastroMensagem.textContent = 'Complete seus dados para criar seu acesso.';
    cadastroForm.classList.remove('hidden');

    document.getElementById('cadastroBtn').addEventListener('click', async () => {
      const nome = document.getElementById('cadNome').value.trim();
      const telefone = document.getElementById('cadTelefone').value.trim();
      const email = document.getElementById('cadEmail').value.trim().toLowerCase();
      const senha = document.getElementById('cadSenha').value;
      const senha2 = document.getElementById('cadSenha2').value;
      const honeypot = document.getElementById('honeypot').value;
      const errorNode = document.getElementById('cadastroError');

      if (honeypot) {
        showError(errorNode, 'Requisição inválida.');
        return;
      }

      if (!nome || !telefone || !email || !senha || !senha2) {
        showError(errorNode, 'Preencha todos os campos.');
        return;
      }

      if (senha.length < 8) {
        showError(errorNode, 'A senha precisa ter pelo menos 8 caracteres.');
        return;
      }

      if (senha !== senha2) {
        showError(errorNode, 'As senhas não conferem.');
        return;
      }

      const payload = {
        acao: 'cadastrar',
        token,
        nome,
        telefone,
        email,
        senha,
        site: '',
      };

      const res = await fetch(`${window.SUPABASE_URL}/functions/v1/cadastro-membro`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': window.SUPABASE_ANON_KEY,
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok || data.erro) {
        showError(errorNode, data.erro || 'Não foi possível concluir o cadastro.');
        return;
      }

      showError(errorNode, 'Cadastro realizado com sucesso!');
      setTimeout(() => {
        window.location.href = '/';
      }, 1200);
    });
  } catch (err) {
    cadastroMensagem.textContent = 'Não foi possível validar o convite.';
  }
}

document.getElementById('loginBtn').addEventListener('click', handleLogin);
document.getElementById('forgotBtn').addEventListener('click', handleForgotPassword);
document.getElementById('password').addEventListener('keydown', (event) => {
  if (event.key === 'Enter') handleLogin();
});
document.getElementById('menuToggle').addEventListener('click', () => {
  document.querySelector('.sidebar').classList.toggle('open');
});

document.getElementById('voltarLoginBtn').addEventListener('click', () => {
  document.getElementById('loginBox').classList.remove('hidden');
  document.getElementById('cadastroBox').classList.add('hidden');
  document.getElementById('cadastroForm').classList.add('hidden');
});

async function bootstrap() {
  await initCadastroPublico();
  const { data: sessionData } = await supabase.auth.getSession();
  if (sessionData.session) {
    await loadPerfil();
  } else {
    toggleLogin(true);
  }
}

bootstrap();

